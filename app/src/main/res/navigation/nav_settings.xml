<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_settings"
    app:startDestination="@id/settingsLobbyFragment">

    <fragment
        android:id="@+id/settingsLobbyFragment"
        android:name="com.example.safeher.settings.lobby.SettingsLobbyFragment"
        android:label="SettingsLobbyFragment" >
        <action
            android:id="@+id/action_settingsLobbyFragment_to_videoLibraryFragment2"
            app:destination="@id/videoLibraryFragment2" >
        <argument
            android:name="from_settings"
            app:argType="boolean" />
        </action>
        <action
            android:id="@+id/action_settingsLobbyFragment_to_pairFragment"
            app:destination="@id/pairFragment" />
    </fragment>
    <fragment
        android:id="@+id/videoLibraryFragment2"
        android:name="com.example.safeher.home_screen.videoLibrary.VideoLibraryFragment"
        android:label="VideoLibraryFragment" >
        <action
            android:id="@+id/action_videoLibraryFragment2_to_settingsLobbyFragment"
            app:destination="@id/settingsLobbyFragment" />
        <argument
            android:name="from_settings"
            app:argType="boolean" />
    </fragment>
    <fragment
        android:id="@+id/pairFragment"
        android:name="com.example.safeher.settings.pair.PairFragment"
        android:label="PairFragment" >
        <action
            android:id="@+id/action_pairFragment_to_settingsLobbyFragment"
            app:destination="@id/settingsLobbyFragment" />
    </fragment>
</navigation>