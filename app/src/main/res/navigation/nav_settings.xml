<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_settings"
    app:startDestination="@id/settingsLobbyFragment">

    <fragment
        android:id="@+id/settingsLobbyFragment"
        android:name="com.example.safeher.settings.lobby.SettingsLobbyFragment"
        android:label="SettingsLobbyFragment">

        <action
            android:id="@+id/action_settingsLobbyFragment_to_videoLibraryFragment2"
            app:destination="@id/videoLibraryFragment2">
            <argument
                android:name="from_settings"
                app:argType="boolean" />
        </action>

        <action
            android:id="@+id/action_settingsLobbyFragment_to_profileFragment"
            app:destination="@id/profileFragment" />

        <action
            android:id="@+id/action_settingsLobbyFragment_to_aboutAppFragment"
            app:destination="@id/aboutAppFragment" />

        <action
            android:id="@+id/action_settingsLobbyFragment_to_mySafeCircleFragment"
            app:destination="@id/mySafeCircleFragment" />

        <action
            android:id="@+id/action_settingsLobbyFragment_to_questionsAndAnswersFragment"
            app:destination="@id/questionsAndAnswersFragment" />

        <action
            android:id="@+id/action_settingsLobbyFragment_to_safeCircleIntroFragment"
            app:destination="@id/safeCircleIntroFragment" />
    </fragment>

    <fragment
        android:id="@+id/videoLibraryFragment2"

        android:name="com.example.safeher.home_screen.videoLibrary.VideoLibraryFragment"
        android:label="VideoLibraryFragment">
        <action
            android:id="@+id/action_videoLibraryFragment2_to_settingsLobbyFragment"
            app:destination="@id/settingsLobbyFragment"/>
        <action
            android:id="@+id/action_videoLibraryFragment2_to_SOSHomeScreenFragment"
            app:destination="@id/SOSHomeScreenFragment" />
        <argument
            android:name="from_settings"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/SafeCircleFragment"
        android:name="com.example.safeher.settings.safeCircle.SafeCircleFragment"
        android:label="SettingsSafeCircleFragment">
        <action
            android:id="@+id/action_settingsSafeCircleFragment_to_mySafeCircleFragment"
            app:destination="@id/mySafeCircleFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.safeher.settings.profile.ProfileFragment"
        android:label="ProfileFragment">
        <action
            android:id="@+id/action_profileFragment_to_settingsLobbyFragment"
            app:destination="@id/settingsLobbyFragment" />
    </fragment>

    <fragment
        android:id="@+id/aboutAppFragment"
        android:name="com.example.safeher.settings.lobby.AboutAppFragment"
        android:label="AboutAppFragment">
        <action
            android:id="@+id/action_aboutAppFragment_to_settingsLobbyFragment"
            app:destination="@id/settingsLobbyFragment" />
    </fragment>

    <fragment
        android:id="@+id/mySafeCircleFragment"
        android:name="com.example.safeher.settings.safeCircle.MySafeCircleFragment"
        android:label="MySafeCircleFragment">
        <action
            android:id="@+id/action_mySafeCircleFragment_to_settingsLobbyFragment"
            app:destination="@id/settingsLobbyFragment" />
        <action
            android:id="@+id/action_mySafeCircleFragment_to_settingsSafeCircleFragment"
            app:destination="@id/SafeCircleFragment" />
    </fragment>

    <fragment
        android:id="@+id/questionsAndAnswersFragment"
        android:name="com.example.safeher.settings.lobby.QuestionsAndAnswersFragment"
        android:label="QuestionsAndAnswersFragment">
        <action
            android:id="@+id/action_questionsAndAnswersFragment_to_settingsLobbyFragment"
            app:destination="@id/settingsLobbyFragment" />
    </fragment>

    <fragment
        android:id="@+id/safeCircleIntroFragment"
        android:name="com.example.safeher.settings.safeCircle.SafeCircleIntroFragment"
        android:label="SafeCircleIntroFragment">
        <action
            android:id="@+id/action_safeCircleIntroFragment_to_safeCircleFragment"
            app:destination="@id/SafeCircleFragment" />
    </fragment>

    <fragment
        android:id="@+id/SOSHomeScreenFragment"
        android:name="com.example.safeher.home_screen.sos.SOSHomeScreenFragment"
        android:label="SOSHomeScreenFragment" />


</navigation>
