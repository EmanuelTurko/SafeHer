<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homePageFragment">

    <fragment
        android:id="@+id/homePageFragment"
        android:name="com.example.safeher.auth.authFragments.HomePageFragment"
        android:label="HomePageFragment" >
        <action
            android:id="@+id/action_homePageFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_homePageFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.safeher.auth.authFragments.LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.safeher.auth.authFragments.RegisterFragment"
        android:label="RegisterFragment" >
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_registerFragment_to_safeCircleIntroFragment"
            app:destination="@id/safeCircleIntroFragment" />
    </fragment>
    <fragment
        android:id="@+id/safeCircleIntroFragment"
        android:name="com.example.safeher.auth.pair.SafeCircleIntroFragment"
        android:label="SafeCircleIntroFragment" >
        <action
            android:id="@+id/action_safeCircleIntroFragment_to_pairFragment"
            app:destination="@id/pairFragment" />
    </fragment>
    <fragment
        android:id="@+id/pairFragment"
        android:name="com.example.safeher.auth.pair.SafeCircleFragment"
        android:label="PairFragment" >
        <action
            android:id="@+id/action_PairFragment_to_loginFragment"
            app:destination="@id/SOSHomeScreenFragment2" />
        <action
            android:id="@+id/action_PairFragment_to_confirmSafeCircleFragment"
            app:destination="@id/confirmSafeCircleFragment" />
    </fragment>
    <fragment
        android:id="@+id/confirmSafeCircleFragment"
        android:name="com.example.safeher.auth.pair.ConfirmSafeCircleFragment"
        android:label="ConfirmSafeCircleFragment" >

        <action
            android:id="@+id/action_confirmSafeCircleFragment_to_SOS"
            app:destination="@id/SOSHomeScreenFragment2" />

        <action
            android:id="@+id/action_confirmSafeCircleFragment_to_pairFragment"
            app:destination="@id/pairFragment" />
    </fragment>


    <fragment
        android:id="@+id/SOSHomeScreenFragment2"
        android:name="com.example.safeher.home_screen.sos.SOSHomeScreenFragment"
        android:label="SOSHomeScreenFragment" />
    <!--<fragment
        android:id="@+id/profileFragment2"
        android:name="com.example.safeher.settings.profile.ProfileFragment"
        android:label="ProfileFragment">
    <argument
        android:name="isAfterRegistrationScreen"
        app:argType="boolean" />
    </fragment> -->

</navigation>