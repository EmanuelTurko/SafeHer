<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="150dp"
    android:layout_height="110dp"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/button_gold">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Author -->
        <TextView
            android:id="@+id/tvPostAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Author Name"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Time -->
        <TextView
            android:id="@+id/tvPostTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="12:34 PM"
            android:textColor="@android:color/darker_gray"
            android:textSize="10sp" />

        <!-- Preview of body (up to 3 lines) -->
        <TextView
            android:id="@+id/textViewPost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_marginTop="0dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="The content of the post"
            android:textColor="@android:color/black"
            android:textSize="12sp" />

        <!-- Action icons + counts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <!-- Like button -->
            <ImageButton
                android:id="@+id/buttonLike_carousel"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_heart"
                android:contentDescription="Like" />

            <!-- Count of likes -->
            <TextView
                android:id="@+id/tvLikeCount_carousel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="@android:color/black"
                android:textSize="12sp" />

            <View
                android:layout_width="16dp"
                android:layout_height="match_parent" />

            <!-- Comment button -->
            <ImageButton
                android:id="@+id/buttonComment_carousel"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_comment"
                android:contentDescription="Comment" />

            <!-- Count of comments -->
            <TextView
                android:id="@+id/tvCommentCount_carousel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="@android:color/black"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
