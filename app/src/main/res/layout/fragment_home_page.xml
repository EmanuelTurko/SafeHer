<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/red_background"
    tools:context=".auth.MainActivity">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/main_activity_mainpage_logo"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginHorizontal="0dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/safeher"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/main_activity_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/versailles"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="60dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_activity_mainpage_logo"
        tools:ignore="SpUsage" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/main_activity_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/poppins_light"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Strength in connection, \npower in community"
        android:textColor="@color/white"
        android:textSize="21dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_activity_title"
        tools:ignore="HardcodedText,SpUsage" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/main_activity_login_button"
        style="@style/SafeHerButton"
        android:layout_marginTop="50dp"
        android:text="@string/login"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_activity_subtitle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/main_activity_signup_button"
        android:layout_marginTop="10dp"
        android:text="@string/sign_up"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_activity_login_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="50dp"
        android:backgroundTint="@color/red_background"
        android:fontFamily="@font/poppins_medium"
        android:letterSpacing="0"
        android:padding="14dp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18dp"
        app:cornerRadius="30dp"
        app:strokeWidth="3dp"
        app:strokeColor="@color/button_gold"
        tools:ignore="SpUsage"/>


    <!-- test textview -->

    <!-- test textview -->

</androidx.constraintlayout.widget.ConstraintLayout>