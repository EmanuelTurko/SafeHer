<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background">

    <!-- Settings Button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/settingsButtonCard"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/settingsButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_settings" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Welcome Text -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="Welcome Shira!"
        android:textColor="#000000"
        android:textSize="24sp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsButtonCard" />

    <!-- Helper Switch Container (default green) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/helperSwitchContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        app:cardBackgroundColor="#66CD5A"
        app:cardCornerRadius="50dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/welcomeText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp">

            <TextView
                android:id="@+id/helperStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="ON"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/helperSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@android:color/white"
                app:trackTint="@android:color/white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Helper Label -->
    <TextView
        android:id="@+id/helperLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/poppins_bold"
        android:text="Helper"
        android:textColor="#2D2D2D"
        android:textSize="19sp"
        app:layout_constraintTop_toBottomOf="@id/helperSwitchContainer"
        app:layout_constraintStart_toStartOf="@id/helperSwitchContainer"
        app:layout_constraintEnd_toEndOf="@id/helperSwitchContainer" />

    <!-- 2×2 Helper Grid -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/helperGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:alignmentMode="alignMargins"
        app:columnCount="2"
        app:columnOrderPreserved="false"
        app:layout_constraintBottom_toTopOf="@+id/sosButtonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/helperLabel"
        app:rowCount="2"
        tools:ignore="MissingClass">

        <!-- Sisters -->
        <LinearLayout
            android:id="@+id/sistersButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_columnWeight="1">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/sisters" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/poppins_bold"
                android:textSize="19sp"
                android:text="Sisters"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- Fake Call -->
        <LinearLayout
            android:id="@+id/supportCallButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_columnWeight="1">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/fake_call" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Fake Call"
                android:textColor="#000000"
                android:textSize="19sp" />
        </LinearLayout>

        <!-- Safe Circle -->
        <LinearLayout
            android:id="@+id/safeCircleButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:gravity="center"
            android:layout_marginTop="55dp"
            android:orientation="vertical"
            app:layout_columnWeight="1">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/safe_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Safe Circle"
                android:textColor="#000000"
                android:textSize="19sp" />
        </LinearLayout>

        <!-- Video Library -->
        <LinearLayout
            android:id="@+id/videoLibraryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:layout_marginTop="55dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_columnWeight="1">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_video_play" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Video Library"
                android:textColor="#000000"
                android:textSize="19sp" />
        </LinearLayout>

    </androidx.gridlayout.widget.GridLayout>

    <!-- SOS Bar at bottom -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sosButtonContainer"
        android:layout_width="420dp"
        android:layout_height="70dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#ff1616"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/sosButton"
            android:layout_gravity="center"
            android:layout_width="141dp"
            android:layout_height="56dp"
            android:contentDescription="SOS"
            android:src="@drawable/ic_sos" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
