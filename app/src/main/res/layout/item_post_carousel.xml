<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="150dp"
    android:layout_height="110dp"
    android:layout_margin="8dp"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    app:cardBackgroundColor="@color/button_gold"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Author -->
        <TextView
            android:id="@+id/tvPostAuthor_carousel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Author Name"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Time -->
        <TextView
            android:id="@+id/tvPostTime_carousel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="12:34 PM"
            android:textColor="@android:color/darker_gray"
            android:textSize="10sp" />

        <!-- Preview of body (up to 3 lines) -->
        <TextView
            android:id="@+id/textViewPost_carousel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="The content of the post"
            android:textColor="@android:color/black"
            android:textSize="12sp" />

        <!-- Action icon: רק כפתור לייק ותגובה (רצוי שיהיו צמודים) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonLike_carousel"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_heart" />

            <ImageButton
                android:id="@+id/buttonComment_carousel"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_comment" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
